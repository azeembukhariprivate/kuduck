<Window x:Class="Kuduck.Views.DuckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KUDUCK duck" Width="300" Height="250"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        AllowDrop="True" FontFamily="{DynamicResource UiFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root" Background="Transparent" MouseLeave="Root_MouseLeave">

        <!-- Suggestion bubble -->
        <Grid x:Name="Bubble" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="40,4,0,0" Width="250" Visibility="Collapsed"
              MouseEnter="Bubble_MouseEnter">
            <Border CornerRadius="14" BorderThickness="1" Padding="12,10,12,12"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel>
                    <TextBlock x:Name="BubbleLabel" Text="LAST TIME" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource ImageAccentBrush}" Margin="0,0,24,2" />
                    <TextBlock x:Name="BubbleText" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,10" Text="Hi! Click me for image and PDF tools." />
                    <Grid x:Name="BubbleButtons">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RepeatButton" Grid.Column="0" Style="{StaticResource InkButton}" Content="Repeat" Click="Repeat_Click" />
                        <Button x:Name="AllToolsButton" Grid.Column="2" Height="34" Content="All tools" FontSize="12"
                                FontWeight="SemiBold" Click="AllTools_Click" />
                    </Grid>
                </StackPanel>
            </Border>
            <Button x:Name="DismissButton" Style="{StaticResource IconButton}" Width="26" Height="26"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                    ToolTip="Hide this suggestion" AutomationProperties.Name="Hide this suggestion" Click="Dismiss_Click" />
            <!-- little pointer towards the duck -->
            <Path Data="M0,0 L16,0 L4,12 Z" Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource BorderBrush}"
                  StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="34,0,0,-11" />
        </Grid>

        <!-- The duck -->
        <Grid x:Name="DuckArea" Width="104" Height="92" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,6"
              Cursor="Hand" Background="Transparent" RenderTransformOrigin="0.5,1" ToolTip="KUDUCK — click to open, drag to move"
              MouseEnter="Duck_MouseEnter" MouseLeftButtonDown="Duck_MouseLeftButtonDown"
              MouseMove="Duck_MouseMove" MouseLeftButtonUp="Duck_MouseLeftButtonUp">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="DuckScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Ellipse Width="80" Height="8" Fill="#33000000" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,0" />
            <Viewbox Margin="0,0,0,4">
                <Canvas Width="56" Height="44">
                    <Canvas.RenderTransform>
                        <TranslateTransform X="-4" Y="-14" />
                    </Canvas.RenderTransform>
                    <Path Data="{StaticResource DuckBody}" Fill="{DynamicResource BrandBrush}" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.2" StrokeLineJoin="Round" />
                    <Path Data="{StaticResource DuckHead}" Fill="{DynamicResource BrandBrush}" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.2" />
                    <Path Data="{StaticResource DuckBeak}" Fill="{DynamicResource BeakBrush}" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.2" StrokeLineJoin="Round" />
                    <Path Data="{StaticResource DuckEye}" Fill="{DynamicResource InkBrush}" />
                </Canvas>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
